<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Render 3D Filament -->
    <SurfaceView
        android:id="@+id/filament_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD atas -->
    <LinearLayout
        android:id="@+id/hud_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hud_speed"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="0 km/h"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/hud_text"
            android:background="@color/hud_bg"
            android:padding="8dp" />

        <TextView
            android:id="@+id/hud_checkpoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="&#x1F4CD; 0/3"
            android:textSize="20sp"
            android:textColor="@color/hud_text"
            android:background="@color/hud_bg"
            android:padding="8dp" />

        <TextView
            android:id="@+id/hud_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="00:00"
            android:textSize="20sp"
            android:textColor="@color/hud_text"
            android:background="@color/hud_bg"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Joystick kiri bawah -->
    <com.hozinking.touring3d.JoystickView
        android:id="@+id/joystick"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:visibility="gone" />

    <!-- Tombol GAS & REM kanan bawah -->
    <LinearLayout
        android:id="@+id/pedal_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_brake"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/brake"
            android:text="REM"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_gas"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:backgroundTint="@color/gas"
            android:text="GAS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Teks countdown di tengah -->
    <TextView
        android:id="@+id/countdown_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="96sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:visibility="gone" />

    <!-- Panel menu awal -->
    <LinearLayout
        android:id="@+id/menu_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/hud_bg"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOURING 3D"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kelilingi pulau, kunjungi 3 spot"
            android:textSize="16sp"
            android:textColor="@color/hud_text" />

        <TextView
            android:id="@+id/best_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/hud_text" />

        <Button
            android:id="@+id/btn_start_tour"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TUR SANTAI"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_start_trial"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="TIME TRIAL"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Panel selesai -->
    <LinearLayout
        android:id="@+id/finish_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/hud_bg"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINISH!"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/finish_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="22sp"
            android:textColor="@color/hud_text" />

        <TextView
            android:id="@+id/finish_best"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="16sp"
            android:textColor="@color/accent" />

        <Button
            android:id="@+id/btn_again"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MAIN LAGI" />
    </LinearLayout>
</FrameLayout>
